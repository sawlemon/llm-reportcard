{
  "name": "llm-reportcard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "prepare": "node tools/setup-git-hooks.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
